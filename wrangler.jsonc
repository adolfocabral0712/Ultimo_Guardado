{
    "$schema": "node_modules/wrangler/config-schema.json",

    "name": "control-actualizaciones",

    "main": "src/index.js",

    "compatibility_date": "2026-08-17",

    "assets": {
        "directory": "./public",
        "binding": "ASSETS",

        "run_worker_first": [
            "/api/*"
        ]
    }
}
